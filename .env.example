TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
FTMO_API_URL=https://gw2.ftmo.com/public-api/v1/economic-calendar
TIMEZONE=Europe/Warsaw
SUMMARY_TIME=07:00
POLL_SECONDS=300
